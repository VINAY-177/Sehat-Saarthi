// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Existing Models
// ============================================================

model Hospital {
  id            String   @id @default(uuid())
  name          String
  type          String
  district      String
  state         String
  location      String
  totalBeds     Int
  availableBeds Int
  icuBeds       Int
  availableIcu  Int
  specialties   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctors    Doctor[]
  referrals  Referral[]
}

model GovernmentScheme {
  id              String   @id @default(uuid())
  schemeName      String
  description     String
  eligibility     String
  coverageAmount  String
  officialLink    String
  stateApplicable String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// Phase 1 — New Models
// ============================================================

model Patient {
  id               String    @id @default(uuid())
  mrn              String    @unique // Medical Record Number
  name             String
  dateOfBirth      String    // ISO date string
  age              Int
  gender           String    // Male, Female, Other
  bloodGroup       String?
  phone            String?
  email            String?
  abhaId           String?   @unique
  abhaLinked       Boolean   @default(false)

  // Address
  address          String?
  village          String?
  city             String?
  district         String
  state            String
  pincode          String?

  // Emergency Contact
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRelation String?

  // Clinical
  riskLevel        String    @default("LOW") // LOW, MODERATE, HIGH, EMERGENCY
  incomeCategory   String?   // BPL, APL, EWS

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  encounters       Encounter[]
  vitals           Vital[]
  conditions       MedicalCondition[]
  allergies        Allergy[]
  medications      Medication[]
  prescriptions    Prescription[]
  labReports       LabReport[]
  documents        MedicalDocument[]
  insurance        Insurance[]
  appointments     Appointment[]
  referralsOut     Referral[]       @relation("PatientReferrals")
}

model Doctor {
  id              String   @id @default(uuid())
  name            String
  specialty       String
  department      String?
  licenseNumber   String?
  phone           String?
  email           String?
  facilityId      String?
  available       Boolean  @default(true)
  experience      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facility        Hospital?       @relation(fields: [facilityId], references: [id])
  appointments    Appointment[]
  encounters      Encounter[]
  prescriptions   Prescription[]
  medicationsPrescribed Medication[] @relation("PrescribingDoctor")
  labReportsOrdered    LabReport[]  @relation("OrderingDoctor")
}

model Appointment {
  id          String   @id @default(uuid())
  patientId   String
  doctorId    String
  dateTime    String   // ISO datetime
  endTime     String?  // ISO datetime
  status      String   @default("REQUESTED") // REQUESTED, CONFIRMED, CHECKED_IN, IN_CONSULTATION, COMPLETED, DECLINED, CANCELLED
  visitType   String   @default("NEW") // NEW, FOLLOW_UP, EMERGENCY
  reason      String?
  notes       String?
  cancelReason String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient     Patient  @relation(fields: [patientId], references: [id])
  doctor      Doctor   @relation(fields: [doctorId], references: [id])
  encounter   Encounter?
}

model Encounter {
  id               String   @id @default(uuid())
  patientId        String
  doctorId         String
  appointmentId    String?  @unique

  // History of Present Illness
  chiefComplaint   String?
  symptoms         String?  // JSON array
  onset            String?  // Sudden, Gradual
  severity         String?  // Mild, Moderate, Severe
  hpiNotes         String?  // Free text narrative

  // Diagnosis
  diagnosis        String?  // Primary diagnosis
  diagnosisIcdCode String?
  secondaryDiagnoses String? // JSON array
  clinicalNotes    String?  // SOAP notes

  // Treatment
  treatmentPlan    String?

  // AI Risk Assessment snapshot
  riskScore        Int?
  urgency          String?  // LOW, MODERATE, HIGH, EMERGENCY
  riskFactors      String?  // JSON array
  suggestedDepartment String?

  // Follow-up
  followUpDate     String?

  status           String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient          Patient     @relation(fields: [patientId], references: [id])
  doctor           Doctor      @relation(fields: [doctorId], references: [id])
  appointment      Appointment? @relation(fields: [appointmentId], references: [id])
  vitals           Vital[]
  prescriptions    Prescription[]
  labOrders        LabReport[]  @relation("EncounterLabReports")
}

model Vital {
  id              String   @id @default(uuid())
  patientId       String
  encounterId     String?

  temperature     Float?   // in °C
  bpSystolic      Int?
  bpDiastolic     Int?
  heartRate       Int?
  respiratoryRate Int?
  spO2            Float?   // percentage
  height          Float?   // in cm
  weight          Float?   // in kg
  bmi             Float?   // auto-calculated

  recordedAt      DateTime @default(now())

  patient         Patient   @relation(fields: [patientId], references: [id])
  encounter       Encounter? @relation(fields: [encounterId], references: [id])
}

model MedicalCondition {
  id          String   @id @default(uuid())
  patientId   String
  name        String
  icdCode     String?
  onsetDate   String?
  status      String   @default("ACTIVE") // ACTIVE, RESOLVED, CHRONIC
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient     Patient  @relation(fields: [patientId], references: [id])
}

model Allergy {
  id          String   @id @default(uuid())
  patientId   String
  allergen    String
  type        String   // DRUG, FOOD, ENVIRONMENTAL
  reaction    String?
  severity    String   @default("MILD") // MILD, MODERATE, SEVERE, LIFE_THREATENING

  createdAt   DateTime @default(now())

  patient     Patient  @relation(fields: [patientId], references: [id])
}

model Medication {
  id                 String   @id @default(uuid())
  patientId          String
  prescribingDoctorId String?
  name               String
  dosage             String
  frequency          String   // e.g., "Twice daily", "Once daily"
  startDate          String
  endDate            String?
  status             String   @default("ACTIVE") // ACTIVE, COMPLETED, DISCONTINUED
  notes              String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patient            Patient  @relation(fields: [patientId], references: [id])
  prescribingDoctor  Doctor?  @relation("PrescribingDoctor", fields: [prescribingDoctorId], references: [id])
}

model Prescription {
  id           String   @id @default(uuid())
  patientId    String
  doctorId     String
  encounterId  String?
  date         String
  notes        String?

  createdAt    DateTime @default(now())

  patient      Patient           @relation(fields: [patientId], references: [id])
  doctor       Doctor            @relation(fields: [doctorId], references: [id])
  encounter    Encounter?        @relation(fields: [encounterId], references: [id])
  items        PrescriptionItem[]
}

model PrescriptionItem {
  id              String @id @default(uuid())
  prescriptionId  String
  medicationName  String
  dosage          String
  frequency       String
  duration        String
  instructions    String?

  prescription    Prescription @relation(fields: [prescriptionId], references: [id])
}

model LabReport {
  id               String   @id @default(uuid())
  patientId        String
  encounterId      String?
  orderingDoctorId String?
  testName         String
  category         String   // CBC, BIOCHEMISTRY, LIVER, KIDNEY, THYROID, LIPID, OTHER
  result           String?
  unit             String?
  referenceRange   String?
  status           String   @default("ORDERED") // ORDERED, SAMPLE_COLLECTED, PROCESSING, COMPLETED
  reportDate       String?
  notes            String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient          Patient   @relation(fields: [patientId], references: [id])
  encounter        Encounter? @relation("EncounterLabReports", fields: [encounterId], references: [id])
  orderingDoctor   Doctor?   @relation("OrderingDoctor", fields: [orderingDoctorId], references: [id])
}

model MedicalDocument {
  id          String   @id @default(uuid())
  patientId   String
  fileName    String
  fileUrl     String?
  category    String   // DISCHARGE_SUMMARY, CONSENT_FORM, IMAGING, LAB_REPORT, PRESCRIPTION, OTHER
  notes       String?

  uploadDate  DateTime @default(now())

  patient     Patient  @relation(fields: [patientId], references: [id])
}

model Insurance {
  id             String   @id @default(uuid())
  patientId      String
  provider       String
  policyNumber   String?
  coverageType   String?  // INDIVIDUAL, FAMILY
  validFrom      String?
  validTo        String?
  pmjayStatus    String?  // ENROLLED, NOT_ENROLLED, PENDING
  cghsStatus     String?  // ACTIVE, INACTIVE, NOT_APPLICABLE

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        Patient  @relation(fields: [patientId], references: [id])
}

model Referral {
  id              String   @id @default(uuid())
  patientId       String
  patientName     String
  fromHospitalId  String?
  toHospitalId    String
  toHospitalName  String
  doctorName      String?
  specialty       String?
  status          String   @default("PENDING") // PENDING, ACCEPTED, EN_ROUTE, ARRIVED, DECLINED
  urgency         String   @default("MODERATE") // LOW, MODERATE, HIGH, EMERGENCY
  reason          String
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient         Patient  @relation("PatientReferrals", fields: [patientId], references: [id])
  toHospital      Hospital @relation(fields: [toHospitalId], references: [id])
}
