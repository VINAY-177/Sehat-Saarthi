// Prisma schema for Sehat Saathi Healthcare Platform
// Production Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. Authentication & User Management
// ============================================================

model User {
  id           String    @id @default(uuid())
  name         String
  phone        String    @unique
  email        String?   @unique
  passwordHash String
  role         String    // PATIENT, DOCTOR, HOSPITAL_STAFF, ADMIN
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient      Patient?
  doctor       Doctor?
  staff        Staff?
}

// ============================================================
// 2. Facilities & Staff Operations
// ============================================================

model Hospital {
  id            String   @id @default(uuid())
  name          String
  type          String   // Government, Tertiary, District, CHC, PHC
  district      String
  state         String
  location      String
  phone         String?
  lat           Float    @default(28.6139)
  lng           Float    @default(77.2090)
  totalBeds     Int      @default(500)
  availableBeds Int      @default(50)
  icuBeds       Int      @default(50)
  availableIcu  Int      @default(5)
  specialties   String   // Comma-separated
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctors       Doctor[]
  staff         Staff[]
  referrals     Referral[]
}

model Staff {
  id          String   @id @default(uuid())
  userId      String?  @unique
  name        String
  role        String   @default("NURSE") // NURSE, RECEPTIONIST, WARD_LEAD, ADMIN
  phone       String?
  email       String?
  facilityId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?     @relation(fields: [userId], references: [id])
  facility    Hospital? @relation(fields: [facilityId], references: [id])
}

// ============================================================
// 3. Clinical Staff & Patients
// ============================================================

model Doctor {
  id              String   @id @default(uuid())
  userId          String?  @unique
  name            String
  specialty       String
  department      String?
  licenseNumber   String?
  phone           String?
  email           String?
  facilityId      String?
  available       Boolean  @default(true)
  experience      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?           @relation(fields: [userId], references: [id])
  facility        Hospital?       @relation(fields: [facilityId], references: [id])
  appointments    Appointment[]
  encounters      Encounter[]
  prescriptions   Prescription[]
  medicationsPrescribed Medication[] @relation("PrescribingDoctor")
  labReportsOrdered    LabReport[]  @relation("OrderingDoctor")
}

model Patient {
  id               String    @id @default(uuid())
  userId           String?   @unique
  mrn              String    @unique // Medical Record Number
  name             String
  dateOfBirth      String?   // ISO date string
  age              Int
  gender           String    // Male, Female, Other
  bloodGroup       String?
  phone            String?
  email            String?
  abhaId           String?   @unique
  abhaLinked       Boolean   @default(false)

  // Address
  address          String?
  village          String?
  city             String?
  district         String
  state            String
  pincode          String?

  // Emergency Contact
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // Clinical & Economic
  riskLevel        String    @default("LOW") // LOW, MODERATE, HIGH, EMERGENCY
  incomeCategory   String?   // BPL, APL, EWS

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  user             User?             @relation(fields: [userId], references: [id])
  encounters       Encounter[]
  vitals           Vital[]
  conditions       MedicalCondition[]
  allergies        Allergy[]
  medications      Medication[]
  prescriptions    Prescription[]
  labReports       LabReport[]
  documents        MedicalDocument[]
  insurance        Insurance[]
  appointments     Appointment[]
  referralsOut     Referral[]        @relation("PatientReferrals")
  interactions     Interaction[]
}

// ============================================================
// 4. Clinical Encounters, Appointments & Care
// ============================================================

model Appointment {
  id           String   @id @default(uuid())
  patientId    String
  doctorId     String
  dateTime     String   // ISO datetime
  endTime      String?  // ISO datetime
  status       String   @default("REQUESTED") // REQUESTED, CONFIRMED, CHECKED_IN, IN_CONSULTATION, COMPLETED, DECLINED, CANCELLED
  visitType    String   @default("NEW") // NEW, FOLLOW_UP, EMERGENCY
  reason       String?
  notes        String?
  cancelReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient      Patient  @relation(fields: [patientId], references: [id])
  doctor       Doctor   @relation(fields: [doctorId], references: [id])
  encounter    Encounter?
}

model Encounter {
  id               String   @id @default(uuid())
  patientId        String
  doctorId         String
  appointmentId    String?  @unique

  // History of Present Illness
  chiefComplaint   String?
  symptoms         String?  // JSON string
  onset            String?
  severity         String?
  hpiNotes         String?

  // Diagnosis
  diagnosis        String?
  diagnosisIcdCode String?
  secondaryDiagnoses String?
  clinicalNotes    String?

  // Treatment
  treatmentPlan    String?

  // AI Risk Assessment snapshot
  riskScore        Int?
  urgency          String?  // LOW, MODERATE, HIGH, EMERGENCY
  riskFactors      String?
  suggestedDepartment String?

  // Follow-up
  followUpDate     String?
  status           String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient          Patient     @relation(fields: [patientId], references: [id])
  doctor           Doctor      @relation(fields: [doctorId], references: [id])
  appointment      Appointment? @relation(fields: [appointmentId], references: [id])
  vitals           Vital[]
  prescriptions    Prescription[]
  labOrders        LabReport[]  @relation("EncounterLabReports")
}

model Vital {
  id              String   @id @default(uuid())
  patientId       String
  encounterId     String?

  temperature     Float?
  bpSystolic      Int?
  bpDiastolic     Int?
  heartRate       Int?
  respiratoryRate Int?
  spO2            Float?
  height          Float?
  weight          Float?
  bmi             Float?
  recordedAt      DateTime @default(now())

  patient         Patient   @relation(fields: [patientId], references: [id])
  encounter       Encounter? @relation(fields: [encounterId], references: [id])
}

model MedicalCondition {
  id          String   @id @default(uuid())
  patientId   String
  name        String
  icdCode     String?
  onsetDate   String?
  status      String   @default("ACTIVE") // ACTIVE, RESOLVED, CHRONIC
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient     Patient  @relation(fields: [patientId], references: [id])
}

model Allergy {
  id          String   @id @default(uuid())
  patientId   String
  allergen    String
  type        String   // DRUG, FOOD, ENVIRONMENTAL
  reaction    String?
  severity    String   @default("MILD") // MILD, MODERATE, SEVERE, LIFE_THREATENING
  createdAt   DateTime @default(now())

  patient     Patient  @relation(fields: [patientId], references: [id])
}

model Medication {
  id                  String   @id @default(uuid())
  patientId           String
  prescribingDoctorId String?
  name                String
  dosage              String
  frequency           String
  startDate           String
  endDate             String?
  status              String   @default("ACTIVE") // ACTIVE, COMPLETED, DISCONTINUED
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  patient             Patient  @relation(fields: [patientId], references: [id])
  prescribingDoctor   Doctor?  @relation("PrescribingDoctor", fields: [prescribingDoctorId], references: [id])
}

model Prescription {
  id           String   @id @default(uuid())
  patientId    String
  doctorId     String
  encounterId  String?
  date         String
  notes        String?
  createdAt    DateTime @default(now())

  patient      Patient           @relation(fields: [patientId], references: [id])
  doctor       Doctor            @relation(fields: [doctorId], references: [id])
  encounter    Encounter?        @relation(fields: [encounterId], references: [id])
  items        PrescriptionItem[]
}

model PrescriptionItem {
  id              String @id @default(uuid())
  prescriptionId  String
  medicationName  String
  dosage          String
  frequency       String
  duration        String
  instructions    String?

  prescription    Prescription @relation(fields: [prescriptionId], references: [id])
}

model LabReport {
  id               String   @id @default(uuid())
  patientId        String
  encounterId      String?
  orderingDoctorId String?
  testName         String
  category         String
  result           String?
  unit             String?
  referenceRange   String?
  status           String   @default("ORDERED") // ORDERED, SAMPLE_COLLECTED, PROCESSING, COMPLETED
  reportDate       String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient          Patient   @relation(fields: [patientId], references: [id])
  encounter        Encounter? @relation("EncounterLabReports", fields: [encounterId], references: [id])
  orderingDoctor   Doctor?   @relation("OrderingDoctor", fields: [orderingDoctorId], references: [id])
}

model MedicalDocument {
  id          String   @id @default(uuid())
  patientId   String
  fileName    String
  fileUrl     String?
  category    String
  notes       String?
  uploadDate  DateTime @default(now())

  patient     Patient  @relation(fields: [patientId], references: [id])
}

model Insurance {
  id             String   @id @default(uuid())
  patientId      String
  provider       String
  policyNumber   String?
  coverageType   String?
  validFrom      String?
  validTo        String?
  pmjayStatus    String?
  cghsStatus     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        Patient  @relation(fields: [patientId], references: [id])
}

model Referral {
  id              String   @id @default(uuid())
  patientId       String
  patientName     String
  fromHospitalId  String?
  toHospitalId    String
  toHospitalName  String
  doctorName      String?
  specialty       String?
  status          String   @default("PENDING") // PENDING, ACCEPTED, EN_ROUTE, ARRIVED, DECLINED
  urgency         String   @default("MODERATE") // LOW, MODERATE, HIGH, EMERGENCY
  reason          String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient         Patient  @relation("PatientReferrals", fields: [patientId], references: [id])
  toHospital      Hospital @relation(fields: [toHospitalId], references: [id])
}

// ============================================================
// 5. Emergency SOS & Dispatch Tracking
// ============================================================

model EmergencyRequest {
  id                   String   @id @default(uuid())
  phone                String
  location             String
  lat                  Float?
  lng                  Float?
  emergencyType        String   @default("GENERAL") // ACCIDENT, CARDIAC, RESPIRATORY, TRAUMA, MATERNAL, GENERAL
  patientName          String?
  age                  Int?
  gender               String?
  assignedHospitalId   String?
  assignedHospitalName String?
  ambulanceId          String?
  status               String   @default("DISPATCHED") // DISPATCHED, EN_ROUTE, ARRIVED, COMPLETED, CANCELLED
  etaMinutes           Int      @default(8)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ============================================================
// 6. Schemes, Messaging & System Communications
// ============================================================

model GovernmentScheme {
  id              String   @id @default(uuid())
  schemeName      String
  description     String
  eligibility     String
  coverageAmount  String
  officialLink    String
  stateApplicable String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Message {
  id             String   @id @default(uuid())
  senderId       String
  senderName     String
  senderRole     String   // DOCTOR, PATIENT, HOSPITAL_STAFF
  recipientId    String
  recipientName  String
  recipientRole  String
  threadId       String
  content        String
  attachmentType String?
  attachmentId   String?
  attachmentData String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Interaction {
  id           String   @id @default(uuid())
  patientId    String
  staffId      String?
  staffName    String?
  type         String
  status       String
  notes        String?
  callbackDate String?
  createdAt    DateTime @default(now())

  patient      Patient  @relation(fields: [patientId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  role      String   // PATIENT, DOCTOR, HOSPITAL_STAFF, ALL
  category  String   // CLINICAL, APPOINTMENT, LAB, REFERRAL, EMERGENCY, SYSTEM
  title     String
  message   String
  link      String?
  urgency   String   @default("NORMAL") // NORMAL, HIGH, EMERGENCY
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
